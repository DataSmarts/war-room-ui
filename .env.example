# The UI's restricted Postgres role (SELECT + harmless writes only — never the owner role)
DATABASE_URL=

# Signs the session cookie and the fallback challenge. `openssl rand -base64 32`.
# Absent or under 32 characters, every route denies — an unset secret must never mean
# "signed with an empty key", which is a doorway rather than a login.
SESSION_SECRET=

# The authenticator's shared secret, base32. Mint it with `node scripts/totp-enrol.mts`,
# which prints the secret, the otpauth:// URI and the code it is producing right now.
# Absent, nobody can sign in — sessions already issued still verify.
ADMIN_TOTP_SECRET=

# Where a fallback code goes when the authenticator is lost. Both or neither: a bot token
# with no chat id has nowhere to deliver, and the login stops offering the fallback rather
# than offering one that silently goes nowhere.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
