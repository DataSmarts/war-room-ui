#!/bin/bash
# Refuse to push if a plaintext env file has drifted from its committed .enc.
# Compares decrypted content rather than re-encrypting: sops output is
# non-deterministic (fresh nonce/timestamp per run), so a byte diff would
# flag every .enc as stale even when nothing meaningful changed.
# Install: git config core.hooksPath .githooks (done automatically by `npm install`).
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"

if ! command -v sops >/dev/null 2>&1; then
  echo "warning: sops not installed — skipping env-encryption check (brew install sops)" >&2
  exit 0
fi

stale=()
for plain in .env .env.*; do
  [ -e "$plain" ] || continue
  case "$plain" in
    *.enc | *.bak | .env.example) continue ;;
  esac
  [[ $plain =~ ^\.env(\.[a-zA-Z0-9_-]+)?$ ]] || continue

  enc="$plain.enc"
  if [ ! -e "$enc" ]; then
    stale+=("$enc (missing)")
    continue
  fi

  tmp=$(mktemp "${TMPDIR:-/tmp}/sops-env.XXXXXX")
  if ! sops -d --input-type dotenv --output-type dotenv "$enc" >"$tmp" 2>/dev/null; then
    rm -f "$tmp"
    echo "warning: could not decrypt $enc to verify — is your age key present?" >&2
    continue
  fi
  # sops drops blank lines on a dotenv round-trip; ignore them like decrypt-env.sh does.
  diff -q -B "$plain" "$tmp" >/dev/null 2>&1 || stale+=("$enc")
  rm -f "$tmp"
done

if [ "${#stale[@]}" -gt 0 ]; then
  echo "error: encrypted env file(s) out of date with local plaintext: ${stale[*]}" >&2
  echo "Run ./encrypt-env.sh, then git add/commit the .enc file(s) before pushing." >&2
  exit 1
fi

# The read layer's two guards. They degrade differently, on purpose.
#
# The tests are pure — no database, no network, no credential — so there is never a reason to
# skip them, and a failure refuses the push.
#
# schema:check asks the database whether it still looks like what src/lib/discovery/schema.ts
# says it looks like. That needs a network and a credential, and a push must not require either:
# no DATABASE_URL (exit 2) or a database that cannot be reached (exit 3) warns and carries on,
# the same way a missing sops does above. A database that ANSWERS and disagrees (exit 1) refuses
# the push, because that is the whole reason the check exists.

echo "pre-push: npm test" >&2
if ! npm test --silent; then
  echo "error: tests failed. Fix them before pushing." >&2
  exit 1
fi

echo "pre-push: npm run schema:check" >&2
set +e
npm run schema:check --silent
schema_status=$?
set -e

case "$schema_status" in
  0) ;;
  2 | 3)
    echo "warning: schema:check could not run (exit $schema_status) — pushing without it." >&2
    ;;
  *)
    echo "error: the database no longer matches src/lib/discovery/schema.ts." >&2
    echo "Fix the read-model, or adopt the migration that moved it, before pushing." >&2
    exit 1
    ;;
esac
